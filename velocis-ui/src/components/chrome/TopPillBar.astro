---
export const prerender = false;

import { auth } from "@/auth";

const session = await auth.api.getSession({
  headers: Astro.request.headers,
});

const user = session?.user;
const userName = user?.name || "User";
const userEmail = user?.email || "";
const userImage = user?.image || "";
---

<div class="absolute left-1/2 top-6 -translate-x-1/2 pointer-events-auto">
  <div class="glass rounded-full h-[44px] px-3 flex items-center gap-3">
    <div class="flex items-center gap-2 pr-1">
      {userImage ? (
        <img
          src={userImage}
          alt={userName}
          class="w-8 h-8 rounded-lg border border-white/12 object-cover"
          onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';"
        />
      ) : null}
      <div
        class={`w-8 h-8 rounded-lg bg-white/10 border border-white/12 flex items-center justify-center ${userImage ? 'hidden' : ''}`}
        style={userImage ? 'display: none;' : ''}
      >
        <svg
          width="32"
          height="32"
          viewBox="0 0 32 32"
          class="w-full h-full rounded-lg"
        >
          <rect
            x="0"
            y="0"
            width="32"
            height="32"
            rx="8"
            ry="8"
            fill="rgba(255,255,255,0.1)"
          />
          <text
            x="50%"
            y="50%"
            text-anchor="middle"
            dominant-baseline="central"
            font-size="12"
            font-weight="600"
            fill="rgba(255,255,255,0.7)"
            font-family="system-ui, -apple-system, sans-serif"
          >
            {userName.charAt(0).toUpperCase()}
          </text>
        </svg>
      </div>
      <div class="text-left leading-tight">
        <div class="text-[12px] font-semibold tracking-tight text-white/90">{userName}</div>
        <div class="text-[11px] text-white/55">{userEmail}</div>
      </div>
    </div>

    <div class="w-px h-6 bg-white/10"></div>

    <div class="flex items-center gap-1" id="window-controls">
      <button
        id="minimize-btn"
        class="w-7 h-7 rounded-full hover:bg-white/8 border border-white/0 hover:border-white/10 transition-all duration-200 flex items-center justify-center group"
        aria-label="Minimize"
      >
        <svg
          width="12"
          height="12"
          viewBox="0 0 12 12"
          fill="none"
          xmlns="http://www.w3.org/2000/svg"
          class="text-white/60 group-hover:text-white/90 transition-colors"
        >
          <path
            d="M2 6H10"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round"
          />
        </svg>
      </button>

      <button
        id="maximize-btn"
        class="w-7 h-7 rounded-full hover:bg-white/8 border border-white/0 hover:border-white/10 transition-all duration-200 flex items-center justify-center group"
        aria-label="Maximize"
      >
        <svg
          width="12"
          height="12"
          viewBox="0 0 12 12"
          fill="none"
          xmlns="http://www.w3.org/2000/svg"
          class="text-white/60 group-hover:text-white/90 transition-colors"
        >
          <path
            d="M2 2H10V10H2V2Z"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round"
            stroke-linejoin="round"
          />
        </svg>
      </button>

      <button
        id="close-btn"
        class="w-7 h-7 rounded-full hover:bg-red-500/20 border border-white/0 hover:border-red-500/30 transition-all duration-200 flex items-center justify-center group"
        aria-label="Close"
      >
        <svg
          width="12"
          height="12"
          viewBox="0 0 12 12"
          fill="none"
          xmlns="http://www.w3.org/2000/svg"
          class="text-white/60 group-hover:text-red-400 transition-colors"
        >
          <path
            d="M3 3L9 9M9 3L3 9"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round"
          />
        </svg>
      </button>
    </div>
  </div>
</div>

<script>
  function sendEvent(type: string) {
    if (typeof window === "undefined") {
      return;
    }

    const win = window as any;
    if (!win.external?.sendMessage) {
      console.warn("window.external.sendMessage is not available. Event not sent:", type);
      return;
    }

    const eventData = { type };
    try {
      const message = JSON.stringify(eventData);
      win.external.sendMessage(message);
    } catch (error) {
      console.error("Failed to send event:", error);
    }
  }

  function setupWindowControls() {
    const minimizeBtn = document.getElementById("minimize-btn");
    const maximizeBtn = document.getElementById("maximize-btn");
    const closeBtn = document.getElementById("close-btn");

    if (minimizeBtn) {
      minimizeBtn.addEventListener("click", () => {
        sendEvent("minimize");
      });
    }

    if (maximizeBtn) {
      maximizeBtn.addEventListener("click", () => {
        sendEvent("maximize");
      });
    }

    if (closeBtn) {
      closeBtn.addEventListener("click", () => {
        sendEvent("close");
      });
    }
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", setupWindowControls);
  } else {
    setupWindowControls();
  }
</script>

