---
import LeftRail from "../chrome/LeftRail.astro";
---

<div class="relative w-full min-h-screen bg-[#0a0a0a]">
  <div class="fixed inset-0 z-10 pointer-events-none">
    <LeftRail />
  </div>

  <main class="relative z-20 pt-12 pb-10" style="padding-left: calc(var(--left-rail-w) + var(--stage-gap) + 24px); padding-right: calc(var(--right-rail-w) + var(--stage-gap) + 24px);">
    <div class="mb-8">
      <h1 class="text-4xl font-bold text-white mb-2">Settings</h1>
      <p class="text-white/60 text-lg">Configure your launcher</p>
    </div>

    <div class="mt-12">
      <div class="glass rounded-xl p-6">
        <p class="text-white/70">Settings content coming soon...</p>
      </div>
    </div>
  </main>
</div>

