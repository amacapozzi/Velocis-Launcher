---
import LeftRail from "../chrome/LeftRail.astro";
import LibrarySection from "../Home/LibrarySection.tsx";
---

<div class="relative w-full min-h-screen bg-[#0a0a0a]">
  <div class="fixed inset-0 z-10 pointer-events-none">
    <LeftRail />
  </div>

  <main class="relative z-20 pt-12 pb-10" style="padding-left: calc(var(--left-rail-w) + var(--stage-gap) + 24px); padding-right: calc(var(--right-rail-w) + var(--stage-gap) + 24px);">
    <div class="mb-8">
      <h1 class="text-4xl font-bold text-white mb-2">Library</h1>
      <p class="text-white/60 text-lg">Your game collection</p>
    </div>

    <div class="mt-12 mb-10">
      <div class="flex items-center justify-between px-2 mb-6">
        <div class="text-[12px] tracking-[0.22em] text-white/70 font-semibold">
          ALL GAMES
        </div>
        <button class="h-7 px-4 rounded-full glass-soft text-[11px] font-semibold text-white/75">
          FILTER
        </button>
      </div>
      <LibrarySection client:load />
    </div>
  </main>
</div>

