generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Game {
  id          String   @id @default(uuid())
  name        String
  description String
  imageUrl    String
  snapshotUrl String
  sizeBytes   Int
  isAvailable Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isAvailable])
}
