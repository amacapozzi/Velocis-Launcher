<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>

    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <InvariantGlobalization>true</InvariantGlobalization>
    <PublishAot>True</PublishAot>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <IsPublishable>True</IsPublishable>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
    <IsPublishable>True</IsPublishable>
  </PropertyGroup>

	<ItemGroup>
		<Content Remove="Photino.Native.dll" />
		<Content Remove="WebView2Loader.dll" />
	</ItemGroup>
	
  <ItemGroup>
    <None Remove="Photino.Native.dll" />
    <None Remove="WebView2Loader.dll" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Photino.Native.dll" />
    <EmbeddedResource Include="WebView2Loader.dll" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Photino.NET" Version="4.0.16" />
  </ItemGroup>

</Project>
